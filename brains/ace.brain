    segments = 5.0
    arc = "ring"
    arc_1 = "cone"
    index_1 = 0.0
    arc_2 = "cone"
    index_2 = 5.0
    arc_3 = "ring"
    index_3 = 7.0
    arc_4 = "ring"
    index_4 = 1.0

